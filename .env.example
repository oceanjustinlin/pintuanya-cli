# Copy to .env; never commit actual credentials.
# auth-login populates the Cookie and a stable device ID after verification.
PINTUANYA_COOKIE=""
PINTUANYA_DEVICE_ID=""
# Optional default group UUID:
# PINTUANYA_GROUP=""
# Optional HTTP transport: urllib (default for API) or curl.
# QR login uses curl by default unless explicitly configured.
# PINTUANYA_TRANSPORT="curl"
